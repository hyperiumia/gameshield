# GameShield — variables de produccion (copiar a /etc/gameshield/env en el VPS)
# NUNCA subir el archivo .env real al repositorio.

# Postgres (servicio local del VPS)
DATABASE_URL=postgresql+psycopg://gameshield:CAMBIAR-CONTRASENA-FUERTE@127.0.0.1:5432/gameshield

# Autenticacion de la API (edge agent y dashboard usan la misma clave)
GAMESHIELD_API_KEY=CAMBIAR-CLAVE-LARGA-ALEATORIA
GAMESHIELD_HMAC_SECRET=CAMBIAR-SECRETO-LARGO-ALEATORIO

# Ventana anti-replay de firmas (segundos)
GAMESHIELD_REPLAY_SECS=300
